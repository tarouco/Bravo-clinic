DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_TEST=
NEON_BRANCH=
NEON_PROJECT_ID=
NEON_BRANCH_PRODUCTION=
NEON_BRANCH_DEV=
SESSION_SECRET=
ENCRYPTION_KEY=
APP_BASE_URL=
# Other origins that serve the same site, comma-separated (CSRF accepts them next to APP_BASE_URL).
APP_EXTRA_ORIGINS=
EMAIL_FROM=
# E-mail provider: SendKit when set, else Resend, else messages stay in the outbox (AD-046).
# `npm run dev` ignores both keys unless EMAIL_SEND_IN_DEV=true.
SENDKIT_API_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
API_PROXY_ORIGIN=
VITE_SITE_URL=
# Funnel analytics (cookieless). VITE_ANALYTICS_PROVIDER is posthog or ga4; empty turns it off.
VITE_ANALYTICS_PROVIDER=
VITE_GA4_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
NEON_API_KEY=
NETLIFY_AUTH_TOKEN=
